# An example .env file

# Configure a username
ADMIN_UI_USERNAME=admin

# An example hash generated using:
# node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# Replace 'yourpassword' with your actual password and use the resulting hash
# Remember: This must be done in the server directory
ADMIN_UI_PASSWORD_HASH=$2b$10$BryPDtre0PYYhntWvPEynOThlCCJLrCt4ufa6iSNIOxXcHPAsA4ES

# Specify a URL. Leave no trailing '/'
CLIENT_ORIGIN=http://localhost:3000

# Make sure to set the CLIENT_ORIGIN port to the PORT value
PORT=3000